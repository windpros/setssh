#!/bin/bash

echo "=========================================="
echo "  System Configuration Script"
echo "=========================================="
echo ""

# Set timezone to Asia/Shanghai
echo "[1/8] Setting timezone to Asia/Shanghai..."
timedatectl set-timezone Asia/Shanghai
echo "✓ Timezone set to: $(timedatectl | grep "Time zone" | awk '{print $3}')"
echo ""

# Configure locale to C.UTF-8
echo "[2/8] Configuring global locale to C.UTF-8..."

# Check if localectl is available
if command -v localectl &> /dev/null; then
    # Use localectl for systemd-based systems
    localectl set-locale LANG=C.UTF-8
    echo "✓ Locale set via localectl"
else
    # Fallback for non-systemd systems
    echo "localectl not found, using fallback method"
fi

# Update /etc/environment
if [ -f /etc/environment ]; then
    if ! grep -q "LANG=C.UTF-8" /etc/environment; then
        echo "LANG=C.UTF-8" >> /etc/environment
        echo "LC_ALL=C.UTF-8" >> /etc/environment
    else
        sed -i 's/^LANG=.*/LANG=C.UTF-8/g' /etc/environment
        if ! grep -q "LC_ALL=C.UTF-8" /etc/environment; then
            echo "LC_ALL=C.UTF-8" >> /etc/environment
        fi
    fi
    echo "✓ Updated /etc/environment"
else
    echo "LANG=C.UTF-8" > /etc/environment
    echo "LC_ALL=C.UTF-8" >> /etc/environment
    echo "✓ Created /etc/environment"
fi

# Update /etc/default/locale if it exists (Debian/Ubuntu)
if [ -d /etc/default ]; then
    echo "LANG=C.UTF-8" > /etc/default/locale
    echo "LC_ALL=C.UTF-8" >> /etc/default/locale
    echo "✓ Updated /etc/default/locale"
fi

# Update /etc/locale.conf (RHEL/CentOS/Fedora)
echo "LANG=C.UTF-8" > /etc/locale.conf
echo "LC_ALL=C.UTF-8" >> /etc/locale.conf
echo "✓ Updated /etc/locale.conf"

# Export for current session
export LANG=C.UTF-8
export LC_ALL=C.UTF-8
echo "✓ Locale exported for current session"

# Add to /etc/profile for all users
if ! grep -q "export LANG=C.UTF-8" /etc/profile; then
    echo "" >> /etc/profile
    echo "# Set locale to C.UTF-8" >> /etc/profile
    echo "export LANG=C.UTF-8" >> /etc/profile
    echo "export LC_ALL=C.UTF-8" >> /etc/profile
    echo "✓ Added locale to /etc/profile"
fi

echo "Current locale: $(locale | grep LANG= | head -1)"
echo ""

# Check and install nano if not installed
echo "[3/8] Checking for nano..."
if ! command -v nano &> /dev/null; then
    echo "nano not found. Installing..."
    yum install -y nano 2>/dev/null || apt-get install -y nano 2>/dev/null
    echo "✓ nano installed successfully"
else
    echo "✓ nano is already installed"
fi
echo ""

# Check and install epel-release if not installed (for CentOS/RHEL)
echo "[4/8] Checking for epel-release..."
if command -v yum &> /dev/null; then
    if ! rpm -q epel-release &> /dev/null; then
        echo "epel-release not found. Installing..."
        yum install -y epel-release
        echo "✓ epel-release installed successfully"
    else
        echo "✓ epel-release is already installed"
    fi
else
    echo "⊘ Not a RHEL/CentOS system, skipping epel-release"
fi
echo ""

# Check and disable SELinux
echo "[5/8] Checking SELinux status..."
if command -v getenforce &> /dev/null; then
    selinux_status=$(getenforce)
    echo "Current SELinux status: $selinux_status"
    
    if [ "$selinux_status" != "Disabled" ]; then
        echo "Disabling SELinux..."
        
        # Disable SELinux temporarily
        setenforce 0 2>/dev/null
        
        # Disable SELinux permanently
        if [ -f /etc/selinux/config ]; then
            sed -i 's/^SELINUX=enforcing/SELINUX=disabled/g' /etc/selinux/config
            sed -i 's/^SELINUX=permissive/SELINUX=disabled/g' /etc/selinux/config
            echo "✓ SELinux disabled (will take effect after reboot)"
        else
            echo "! SELinux config file not found"
        fi
    else
        echo "✓ SELinux is already disabled"
    fi
else
    echo "⊘ SELinux not found on this system"
fi
echo ""

# Configure SSH
echo "[6/8] Configuring SSH..."

# Check and create .ssh folder
if [ ! -d ~/.ssh ]; then
    mkdir ~/.ssh
    chmod 700 ~/.ssh
    echo "✓ Created .ssh directory"
fi

# Check if authorized_keys file exists and if not, create it
if [ ! -f ~/.ssh/authorized_keys ]; then
    touch ~/.ssh/authorized_keys
    chmod 600 ~/.ssh/authorized_keys
    echo "✓ Created authorized_keys file"
fi

# Check if public key already exists and if not, add it
if ! grep -q "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJPz1R5Ubh/HvnylrJR+WuoVGlqYl9MC/4BIzz0jxzTa eddsa-key-General" ~/.ssh/authorized_keys; then
    echo "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJPz1R5Ubh/HvnylrJR+WuoVGlqYl9MC/4BIzz0jxzTa eddsa-key-General" >> ~/.ssh/authorized_keys
    echo "✓ SSH public key added"
else
    echo "✓ SSH public key already exists"
fi

# Change ssh port
if [ -f /etc/ssh/sshd_config ]; then
    sed -i 's/#Port 22/Port 54321/g' /etc/ssh/sshd_config
    sed -i 's/^Port 22/Port 54321/g' /etc/ssh/sshd_config
    echo "✓ SSH port changed to 54321"
fi

# Disable password login
if [ -f /etc/ssh/sshd_config ]; then
    sed -i 's/#PasswordAuthentication yes/PasswordAuthentication no/g' /etc/ssh/sshd_config
    sed -i 's/^PasswordAuthentication yes/PasswordAuthentication no/g' /etc/ssh/sshd_config
    echo "✓ Password authentication disabled"
fi

# Allow root login via SSH
if [ -f /etc/ssh/sshd_config ]; then
    sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin yes/g' /etc/ssh/sshd_config
    sed -i 's/^PermitRootLogin prohibit-password/PermitRootLogin yes/g' /etc/ssh/sshd_config
    echo "✓ Root login via SSH enabled"
fi

# Restart sshd service
systemctl restart sshd
echo "✓ SSH service restarted"
echo ""

# Enable BBR
echo "[7/8] Enabling BBR congestion control..."

# Check kernel version (BBR requires kernel 4.9+)
kernel_version=$(uname -r | cut -d. -f1)
kernel_minor=$(uname -r | cut -d. -f2)

if [ "$kernel_version" -lt 4 ] || ([ "$kernel_version" -eq 4 ] && [ "$kernel_minor" -lt 9 ]); then
    echo "! Warning: BBR requires kernel 4.9+. Current: $(uname -r)"
    echo "! BBR may not work properly on this system"
else
    echo "✓ Kernel version $(uname -r) supports BBR"
fi

# Enable BBR congestion control
if ! grep -q "net.core.default_qdisc=fq" /etc/sysctl.conf; then
    echo "net.core.default_qdisc=fq" >> /etc/sysctl.conf
fi

if ! grep -q "net.ipv4.tcp_congestion_control=bbr" /etc/sysctl.conf; then
    echo "net.ipv4.tcp_congestion_control=bbr" >> /etc/sysctl.conf
fi

# Apply sysctl settings
sysctl -p > /dev/null 2>&1

# Verify BBR is enabled
bbr_status=$(sysctl net.ipv4.tcp_congestion_control 2>/dev/null | awk '{print $3}')
if [ "$bbr_status" = "bbr" ]; then
    echo "✓ BBR successfully enabled"
else
    echo "! BBR enabling may have failed. Status: $bbr_status"
fi
echo ""

# Summary
echo "[8/8] Cleanup..."
# Remove self
rm -- "$0"
echo "✓ Script removed"
echo ""

echo "=========================================="
echo "  Configuration Complete!"
echo "=========================================="
echo ""
echo "Summary of changes:"
echo "  • Timezone: Asia/Shanghai"
echo "  • Locale: C.UTF-8 (global)"
echo "  • nano: Installed/Verified"
echo "  • epel-release: Installed/Verified (if RHEL/CentOS)"
echo "  • SELinux: Disabled"
echo "  • SSH Port: 54321"
echo "  • SSH Password Auth: Disabled"
echo "  • SSH Root Login: Enabled"
echo "  • BBR: Enabled"
echo ""
echo "⚠ IMPORTANT: Please reconnect using port 54321"
echo "⚠ SELinux and locale changes require a reboot to take full effect"
echo "⚠ After reboot, verify locale with: locale"
echo ""
echo "=========================================="
